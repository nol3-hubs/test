{
  "manifest_version": 3,
  "name": "SPX BRIDGE",
  "version": "69.3.8",
  "description": "Unified SPX BRIDGE for BADOC HUB operations, recipient lookup, and integrated POD/POOH Checker.",
  "permissions": [
    "cookies",
    "scripting",
    "tabs",
    "activeTab",
    "storage",
    "windows"
  ],
  "host_permissions": [
    "https://spx.shopee.ph/*",
    "https://*.susercontent.com/*",
    "https://*.file.susercontent.com/*",
    "https://nol3-hubs.github.io/*",
    "https://docs.google.com/*",
    "https://docs.googleusercontent.com/*",
    "https://accounts.google.com/*",
    "https://drive.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://sheets.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://localhost/*",
        "https://127.0.0.1/*",
        "https://nol3-hubs.github.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://spx.shopee.ph/*"
      ],
      "js": [
        "pod-page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://spx.shopee.ph/*"
      ],
      "js": [
        "pod-content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "short_name": "SPX BRIDGE",
  "web_accessible_resources": [
    {
      "resources": [
        "pod-checker.html",
        "pod-checker.js",
        "pod-icon48.png"
      ],
      "matches": [
        "https://nol3-hubs.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ]
}
