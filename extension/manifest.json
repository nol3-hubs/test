{
  "manifest_version": 3,
  "name": "Bacarra Hub Extension",
  "version": "73.0.0",
  "description": "Bacarra Hub extension for SPX operations, Dispatch and integrated POD/POOH checking (v73).",
  "permissions": [
    "cookies",
    "scripting",
    "tabs",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://spx.shopee.ph/*",
    "https://*.susercontent.com/*",
    "https://*.file.susercontent.com/*",
    "https://nol3-hubs.github.io/*",
    "https://docs.google.com/*",
    "https://docs.googleusercontent.com/*",
    "https://accounts.google.com/*",
    "https://drive.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://sheets.google.com/*",
    "https://*.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://localhost/*",
        "https://127.0.0.1/*",
        "https://nol3-hubs.github.io/*",
        "https://*.github.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://spx.shopee.ph/*"
      ],
      "js": [
        "pod-checker/page_bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://spx.shopee.ph/*"
      ],
      "js": [
        "pod-checker/content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "short_name": "Bacarra Hub Extension",
  "web_accessible_resources": [
    {
      "resources": [
        "pod-checker/app.html",
        "pod-checker/app.js",
        "pod-checker/icon48.png"
      ],
      "matches": [
        "https://nol3-hubs.github.io/*",
        "https://*.github.io/*"
      ]
    }
  ],
  "icons": {
    "16": "pod-checker/icon16.png",
    "32": "pod-checker/icon32.png",
    "48": "pod-checker/icon48.png",
    "128": "pod-checker/icon128.png"
  }
}
